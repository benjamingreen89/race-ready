{
  "hosting": [
    {
      "site": "formhq",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "archive/**",
        "Form/**",
        "*.pdf",
        "*.docx",
        "*.jsx",
        "*.JPG",
        "IMG_*.PNG",
        "Form App design",
        "Screenshot*",
        "Design guide.png",
        "Evolt.png",
        "icon - transparent.png"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/form.html"
        }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/form.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "form-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "form-manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(png|svg|ico|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    },
    {
      "site": "race-ready-3ad33",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "archive/**",
        "Form/**",
        "*.pdf",
        "*.docx",
        "*.jsx",
        "*.JPG",
        "IMG_*.PNG",
        "Form App design",
        "Screenshot*",
        "Design guide.png",
        "Evolt.png",
        "icon - transparent.png"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://formhq.web.app",
          "type": 301
        },
        {
          "source": "/form.html",
          "destination": "https://formhq.web.app",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
