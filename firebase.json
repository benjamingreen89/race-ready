{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "archive/**",
      "Form/**",
      "*.pdf",
      "*.docx",
      "*.jsx",
      "*.JPG",
      "IMG_*.PNG",
      "Form App design",
      "Screenshot*",
      "Design guide.png",
      "Evolt.png"
    ],
    "rewrites": [
      { "source": "/", "destination": "/form.html" }
    ],
    "headers": [
      {
        "source": "form-sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
